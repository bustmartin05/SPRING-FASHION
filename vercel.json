{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/payment-success.html",
      "dest": "/public/payment-success.html"
    },
    {
      "src": "/dlocal-checkout.html",
      "dest": "/public/dlocal-checkout.html"
    },
    {
      "src": "/admin",
      "dest": "/public/index.html"
    },
    {
      "src": "/(css|js|img|uploads)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/favicon.(ico|png)",
      "dest": "/public/favicon.$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}